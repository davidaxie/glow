<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Glow</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Glow configuration, from ios/Glow/Config/*.xcconfig. Read by AppCore's AppConfig. -->
	<key>GlowAPIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>GlowSupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>GlowSupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>GlowWebDomain</key>
	<string>$(GLOW_WEB_DOMAIN)</string>
	<key>GlowPostHogKey</key>
	<string>$(POSTHOG_KEY)</string>
	<key>GlowPostHogHost</key>
	<string>$(POSTHOG_HOST)</string>
	<key>GlowSentryDSN</key>
	<string>$(SENTRY_DSN)</string>

	<!-- Purpose strings. -->
	<key>NSCameraUsageDescription</key>
	<string>Glow uses the camera for a quick photo of today's outfit and to scan room codes. Faces are blurred on your iPhone before anything is uploaded.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Glow lets you pick profile photos from your library. It only sees the photos you choose.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Glow checks once that you're inside the room you're joining, then forgets your location. It's never stored.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>RoomCheck</key>
		<string>Glow needs your precise location once to confirm you're inside this room. It isn't stored.</string>
	</dict>

	<!-- Push and the glow countdown. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- The glow:// link scheme and local networking are added to Debug builds only, by the
	     "Debug-only Info.plist keys" build phase in project.yml. -->

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
