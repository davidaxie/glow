# The seeded demo room, for `scripts/sim.sh at` and `scripts/sim.sh scan`. Sourced by sim.sh.
#
# Copied from A2's supabase/seed.sql (branch w0/a2-contracts, 2026-10-24). This is the only place
# these values live on the iOS side: if the seed changes, change them here.
# The venue itself is still a placeholder (A2's docs/DECISIONS.md, "Placeholder venue").

GLOW_DEMO_ROOM_ID="de000000-0000-4000-8000-000000000001"
GLOW_DEMO_SLUG="demo"
# Room center (a public venue, so fine to store): Palace of Fine Arts, San Francisco. Radius 200 m.
GLOW_DEMO_LAT="37.8029"
GLOW_DEMO_LNG="-122.4484"
# Static poster token (the demo room has allow_static_qr on).
GLOW_DEMO_TOKEN="DEMOSTATICTOKEN2"
# The 6-character room code people can type in.
GLOW_DEMO_CODE="HACK26"
