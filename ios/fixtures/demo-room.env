# The seeded demo room, for `scripts/sim.sh at` and `scripts/sim.sh scan`. Sourced by sim.sh.
#
# PLACEHOLDER VALUES until A2's supabase/seed.sql is merged: copy the demo room's slug,
# center, static poster token and room code from there. This is the only place they live
# on the iOS side.

GLOW_DEMO_SLUG="demo"
# Room center (a public venue, so fine to store). Placeholder: Palace of Fine Arts, San Francisco.
GLOW_DEMO_LAT="37.8029"
GLOW_DEMO_LNG="-122.4484"
# Static poster token for the demo room (rooms with allow_static_qr accept it).
GLOW_DEMO_TOKEN="DEMOTOKEN"
# The 6-character room code people can type in.
GLOW_DEMO_CODE="DEMO42"
