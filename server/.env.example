# Glow server environment.
#
# Local development: run `pnpm env:setup` from the repo root. It copies this file to
# server/.env.local, fills in the keys from `supabase status`, and generates fresh
# secrets. Copying this file by hand also works with a default `supabase start`.
#
# Vercel: set these in the project's Environment Variables. The server refuses to
# start on Vercel with localhost URLs, local demo keys, placeholder secrets, or
# ALLOW_TEST_LOGIN. Never commit a filled-in copy of this file.
#
# Required in: L = local, P = Vercel preview, V = Vercel production.

# --- Supabase (L P V) ----------------------------------------------------------------
# The values below are the public demo keys every local `supabase start` uses. They
# only work against a Supabase running on this machine. The local stack uses ports
# 54420 to 54424 (see supabase/config.toml), not the Supabase defaults.
SUPABASE_URL=http://127.0.0.1:54421
# The anon (publishable) key. The only Supabase key the iPhone app ever holds.
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Server only. Never in the app, the admin bundle or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# --- Signing secrets (L P V) -----------------------------------------------------------
# At least 32 random bytes each, all different: `openssl rand -base64 32`.
# These placeholders work locally and are rejected on Vercel.
JOIN_TICKET_SECRET=local-dev-only-join-ticket-secret-replace-me-0001
CARD_URL_SECRET=local-dev-only-card-url-secret-replace-me-0000000002
# Protects GET /api/cron/purge. Vercel Cron sends it as a Bearer token.
CRON_SECRET=local-dev-only-cron-secret-replace-me-000000000000003

# --- Moderation and rate limits (P V) -------------------------------------------------
# Claude moderation for photos and messages.
ANTHROPIC_API_KEY=
# Upstash Redis for rate limits. Set both or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Apple push (V) ---------------------------------------------------------------------
# Token auth with the .p8 key from B9. Set all four or none. On Vercel, paste the .p8
# file's contents as-is; locally, use one line with \n for each line break.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# --- App links (optional everywhere) --------------------------------------------------
# The public TestFlight link shown on /r/{slug} to people who don't have Glow yet.
TESTFLIGHT_URL=
# TEAMID.bundle.id for /.well-known/apple-app-site-association, like ABCDE12345.com.davidxie.glow.
APPLE_APP_ID=

# --- Analytics and errors (optional everywhere) ---------------------------------------
# No personal data is ever sent. Sentry is off when SENTRY_DSN is empty.
POSTHOG_KEY=
SENTRY_DSN=

# --- Local only -----------------------------------------------------------------------
# Turns on POST /api/dev/test-login for Simulator automation. Only allowed with a
# local SUPABASE_URL, and never on Vercel.
ALLOW_TEST_LOGIN=

# Blind mode, stage only: true opens Blind drops at any time instead of from 8pm Pacific.
# Never in production (it lets someone learn which swipe was mutual).
BLIND_DEMO_MODE=
