// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`every push payload (P6) > checkin.expiring 1`] = `
{
  "body": {
    "aps": {
      "alert": {
        "body": "Your check-in ends soon.",
      },
      "category": "CHECKIN",
      "interruption-level": "active",
      "sound": "default",
      "thread-id": "room:de000000-0000-4000-8000-000000000001",
    },
    "roomId": "de000000-0000-4000-8000-000000000001",
    "type": "checkin.expiring",
  },
  "headers": {
    ":method": "POST",
    ":path": "/3/device/abababababababababababababababababababababababababababababababab",
    "apns-collapse-id": "checkin.expiring:de000000-0000-4000-8000-000000000001",
    "apns-expiration": "1792873800",
    "apns-priority": "10",
    "apns-push-type": "alert",
    "apns-topic": "com.davidxie.glow",
    "content-type": "application/json",
  },
}
`;

