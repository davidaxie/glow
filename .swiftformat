# SwiftFormat for the iOS app. Owner: A1 (built by A3). `scripts/sim.sh lint` runs `swiftformat --lint --config .swiftformat ios`.

--swiftversion 6.2
--exclude node_modules,ios/build,ios/Glow.xcodeproj,ios/Packages/GlowKit/.build,ios/Packages/GlowKit/Sources/APIClient/Generated,ios/fastlane

--indent 4
--maxwidth 140
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas always
--self remove
--importgrouping testable-last
--header ignore
--stripunusedargs closure-only
--ifdef indent
--extensionacl on-declarations

# Keep explicit Sendable, plain `//` ownership comments, and test names as written.
--disable redundantSendable,docComments,swiftTestingTestCaseNames
