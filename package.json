{
  "name": "glow",
  "private": true,
  "description": "Glow: find out, privately, that you noticed each other.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter server dev",
    "build": "pnpm --filter server build",
    "start": "pnpm --filter server start",
    "typecheck": "pnpm --filter server typecheck",
    "lint": "pnpm --filter server lint",
    "test": "pnpm --filter server test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "ci:local": "scripts/ci-local.sh",
    "env:setup": "scripts/env-setup.sh",
    "dev:token": "scripts/dev-token.sh",
    "smoke": "scripts/smoke.sh",
    "stubs": "node scripts/stub-routes.mjs",
    "codegen": "scripts/codegen.sh",
    "db:start": "scripts/db.sh start",
    "db:stop": "scripts/db.sh stop",
    "db:reset": "scripts/db.sh reset",
    "db:test": "scripts/db.sh test",
    "agent-env": "scripts/agent-env.sh"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
